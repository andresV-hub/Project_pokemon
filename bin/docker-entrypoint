#!/bin/bash
set -e

# compose ya espera al healthcheck de MySQL, pero al reiniciar sólo el servicio
# web conviene confirmar que la base acepta conexiones con estas credenciales.
# --skip-ssl porque el cliente de MariaDB que trae Debian rechaza el certificado
# autofirmado de MySQL 8.4; mysql2 sí se conecta sin verificarlo.
if [ -n "${SETTINGS__DATABASE__DB_HOST}" ]; then
  echo "Esperando a MySQL en ${SETTINGS__DATABASE__DB_HOST}..."
  until mysqladmin ping \
      --host="${SETTINGS__DATABASE__DB_HOST}" \
      --user="${SETTINGS__DATABASE__DB_USERNAME}" \
      --password="${DB_PASSWORD}" \
      --skip-ssl --silent 2>/dev/null; do
    sleep 1
  done
  echo "MySQL disponible."
fi

# Sólo para el arranque del servidor: crea la base si no existe, aplica las
# migraciones pendientes y compila los assets.
if [ "${1}" = "./bin/rails" ] && [ "${2}" = "server" ]; then
  # tmp/ es un volumen persistente: un pid antiguo impediría arrancar Puma.
  rm -f tmp/pids/server.pid
  ./bin/rails db:prepare
  npm run build:css
fi

exec "${@}"
