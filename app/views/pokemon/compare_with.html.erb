<%# Comparador (styles.md §6.8). Antes esta vista era una copia literal del show
    y no comparaba nada: no usaba ni @pokemon_api ni las diferencias.
    Las diferencias se emparejan aquí por clave de estadística (hp, attack,
    defense…) en lugar de por posición, porque el array que llega en @stats
    cruza `defense` con `special-attack` (ver el informe de la revisión). %>
<% mine = @pokemon.stat_list.index_by { |stat| stat[:key] } %>
<% theirs = @pokemon_api.stat_list.index_by { |stat| stat[:key] } %>
<% rows = mine.keys.map { |key| [mine[key], theirs[key]] } %>
<% balance = rows.sum { |mine_stat, their_stat| mine_stat[:value] - their_stat.to_h.fetch(:value, 0) } %>

<%= render layout: 'application/page_header',
           locals: { eyebrow: 'Comparison',
                     title: "#{@pokemon.display_name} vs #{@pokemon_api.name}" } do %>
  <%= link_to 'Back to details', user_pokemon_path(user_id: current_user.id, id: @pokemon.id),
              class: 'dex-btn dex-btn--ghost' %>
<% end %>

<section class="dex-surface dex-surface--padded dex-surface--split">
  <div class="dex-surface__body">
    <div class="dex-compare__head dex-tinted--<%= @pokemon.type_slug %>">
      <%= render 'application/sprite', pokemon: @pokemon, variant: :pixel, eager: true %>
      <div>
        <p class="dex-compare__name"><%= @pokemon.display_name %></p>
        <p class="dex-card__species"><%= @pokemon.species_name %> · <%= @pokemon.dex_number %></p>
        <%= render 'application/type_chips', pokemon: @pokemon %>
      </div>
    </div>

    <div class="dex-compare__head dex-tinted--<%= @pokemon_api.type_slug %>">
      <%= render 'application/sprite', pokemon: @pokemon_api, variant: :pixel, eager: true %>
      <div>
        <p class="dex-compare__name"><%= @pokemon_api.name %></p>
        <p class="dex-card__species">Catalog species · <%= @pokemon_api.dex_number %></p>
        <%= render 'application/type_chips', pokemon: @pokemon_api %>
      </div>
    </div>
  </div>
</section>

<%# Ventaja de tipos. Para saber cómo golpea A a B basta con mirar el matchup
    defensivo de B en el tipo de A. Se usa el tipo primario de cada uno como su
    tipo de ataque: un Pokémon capturado sólo guarda uno, así que tomar el
    primario mantiene la comparación simétrica. %>
<% mine_hits = @their_matchups.fetch(@pokemon.type_slug, 1.0) %>
<% theirs_hits = @my_matchups.fetch(@pokemon_api.type_slug, 1.0) %>

<section class="dex-surface mt-4">
  <div class="dex-surface__head">
    <h2>Type advantage</h2>
  </div>

  <div class="dex-surface__body dex-compare">
    <div class="dex-compare__row">
      <span class="dex-compare__label">
        <%= @pokemon.display_name %>'s <%= @pokemon.type_slug.capitalize %> against <%= @pokemon_api.name %>
      </span>
      <span class="dex-compare__value dex-compare__value--mine"><%= type_multiplier_label(mine_hits) %></span>
      <span class="dex-compare__delta dex-compare__delta--<%= mine_hits > 1 ? 'up' : (mine_hits < 1 ? 'down' : 'tie') %>">
        <span aria-hidden="true"><%= mine_hits > 1 ? '▲' : (mine_hits < 1 ? '▼' : '=') %></span>
      </span>
      <span class="dex-compare__value dex-compare__value--theirs"></span>
    </div>

    <div class="dex-compare__row">
      <span class="dex-compare__label">
        <%= @pokemon_api.name %>'s <%= @pokemon_api.type_slug.capitalize %> against <%= @pokemon.display_name %>
      </span>
      <span class="dex-compare__value dex-compare__value--mine"></span>
      <span class="dex-compare__delta dex-compare__delta--<%= theirs_hits > 1 ? 'up' : (theirs_hits < 1 ? 'down' : 'tie') %>">
        <span aria-hidden="true"><%= theirs_hits > 1 ? '▲' : (theirs_hits < 1 ? '▼' : '=') %></span>
      </span>
      <span class="dex-compare__value dex-compare__value--theirs"><%= type_multiplier_label(theirs_hits) %></span>
    </div>

    <p class="dex-compare__verdict">
      <% if mine_hits > theirs_hits %>
        <%= @pokemon.display_name %> has the type advantage.
      <% elsif theirs_hits > mine_hits %>
        <%= @pokemon_api.name %> has the type advantage.
      <% else %>
        Neither has a type advantage.
      <% end %>
    </p>
  </div>
</section>

<section class="dex-surface mt-4">
  <div class="dex-surface__head">
    <h2>Base stats</h2>
  </div>

  <div class="dex-surface__body dex-compare">
    <% rows.each do |mine_stat, their_stat| %>
      <% their_value = their_stat.to_h.fetch(:value, 0) %>
      <% delta = mine_stat[:value] - their_value %>
      <div class="dex-compare__row">
        <span class="dex-compare__label"><%= mine_stat[:label] %></span>

        <span class="dex-compare__value dex-compare__value--mine"><%= mine_stat[:value] %></span>

        <%# Icono además de color: la diferencia nunca se marca sólo con color, y
            el valor menor va en gris porque perder no es un error (§6.8). %>
        <% if delta.positive? %>
          <span class="dex-compare__delta dex-compare__delta--up">
            <span aria-hidden="true">▲</span>
            <span>+<%= delta %></span>
            <span class="dex-visually-hidden">in favor of <%= @pokemon.display_name %></span>
          </span>
        <% elsif delta.negative? %>
          <span class="dex-compare__delta dex-compare__delta--down">
            <span aria-hidden="true">▼</span>
            <span><%= delta %></span>
            <span class="dex-visually-hidden">in favor of <%= @pokemon_api.name %></span>
          </span>
        <% else %>
          <span class="dex-compare__delta dex-compare__delta--tie">
            <span aria-hidden="true">=</span>
            <span class="dex-visually-hidden">tie</span>
          </span>
        <% end %>

        <span class="dex-compare__value dex-compare__value--theirs"><%= their_value %></span>
      </div>
    <% end %>

    <p class="dex-compare__verdict">
      <% if balance.positive? %>
        <%= @pokemon.display_name %> has <%= balance %> more total base stat points than <%= @pokemon_api.name %>.
      <% elsif balance.negative? %>
        <%= @pokemon_api.name %> has <%= balance.abs %> more total base stat points than <%= @pokemon.display_name %>.
      <% else %>
        Both have the exact same total base stat points.
      <% end %>
    </p>
  </div>
</section>
