<div class="dex-auth">
  <%= render 'application/auth_lockup', title: 'Sign in' %>

  <section class="dex-surface dex-surface--padded">
    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <div class="dex-field">
        <%= f.label :email, 'Email address', class: 'dex-field__label' %>
        <%= f.email_field :email, autofocus: true, autocomplete: 'email', placeholder: 'you@example.com' %>
      </div>

      <div class="dex-field">
        <%= f.label :password, 'Password', class: 'dex-field__label' %>
        <%= f.password_field :password, autocomplete: 'current-password' %>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="dex-field dex-field__check">
          <%= f.check_box :remember_me %>
          <%= f.label :remember_me, 'Remember me' %>
        </div>
      <% end %>

      <div class="dex-auth__actions">
        <%= f.submit 'Sign in', class: 'dex-btn dex-btn--primary dex-btn--form dex-btn--block' %>
      </div>
    <% end %>
  </section>

  <%= render 'devise/shared/links' %>
</div>
