<%= render layout: 'application/page_header',
           locals: { eyebrow: 'Pokédex', title: @pokemon.name } do %>
  <%= link_to 'Back to catalog', user_pokedex_index_path(user_id: current_user.id),
              class: 'dex-btn dex-btn--ghost' %>
  <%# Ya no se captura desde la Pokédex: los Pokémon se consiguen en encuentros
      (§6.23). La ficha es sólo el registro de lo que te has encontrado. %>
  <%= link_to user_explore_path(user_id: current_user.id),
              class: 'dex-btn dex-btn--accent' do %>
    <i class="fa fa-compass" aria-hidden="true"></i>
    <span>Explore</span>
  <% end %>
<% end %>

<section class="dex-surface dex-surface--padded">
  <div class="dex-hero">
    <div>
      <%# Artwork oficial en la ficha; el sprite pequeño se reserva a los
          listados (styles.md §6.13). %>
      <%= render 'application/sprite', pokemon: @pokemon, variant: :artwork, eager: true %>

      <p class="dex-hero__number">
        <%= @pokemon.dex_number %>
        <% if @pokemon.cry_url.present? %>
          <button type="button"
                  class="dex-cry"
                  data-controller="cry"
                  data-cry-url-value="<%= @pokemon.cry_url %>"
                  data-action="cry#play"
                  aria-label="Play <%= @pokemon.name %>'s cry">
            <i class="fa fa-volume-high" aria-hidden="true"></i>
          </button>
        <% end %>
      </p>
      <%= render 'application/type_chips', pokemon: @pokemon %>

      <dl class="dex-hero__meta">
        <div>
          <dt>Habitat</dt>
          <dd><%= @description&.habitat || 'Unknown' %></dd>
        </div>
        <div>
          <dt>Catch rate</dt>
          <dd><%= @description&.capture_rate ? "#{@description.capture_rate}%" : '—' %></dd>
        </div>
        <div>
          <dt>Base happiness</dt>
          <dd><%= @description&.base_happiness || '—' %></dd>
        </div>
        <div>
          <dt>Height</dt>
          <dd><%= @pokemon.height_in_metres ? "#{@pokemon.height_in_metres} m" : '—' %></dd>
        </div>
        <div>
          <dt>Weight</dt>
          <dd><%= @pokemon.weight_in_kilos ? "#{@pokemon.weight_in_kilos} kg" : '—' %></dd>
        </div>
      </dl>
    </div>

    <div>
      <h2 class="dex-section-title">Description</h2>
      <% if @description&.description.present? %>
        <p class="dex-hero__description"><%= @description.description %></p>
      <% else %>
        <p class="dex-hero__description"><%= t('.no_description', default: 'The PokeAPI does not have a Pokédex entry for this species.') %></p>
      <% end %>

      <h2 class="dex-section-title">Base stats</h2>
      <%= render 'application/stat_bars', pokemon: @pokemon %>

      <h2 class="dex-section-title">Type matchups</h2>
      <%= render 'application/matchups', matchups: @matchups %>

      <h2 class="dex-section-title">Evolution</h2>
      <%= render 'application/evolution_chain', stages: @evolution_stages, current_id: @pokemon.num_pokedex %>

      <% if @pokemon.level_moves.any? %>
        <h2 class="dex-section-title">Moves learned by level</h2>
        <ul class="dex-moves">
          <% @pokemon.level_moves.first(8).each do |move, level| %>
            <li>
              <%= move %>
              <span class="dex-moves__level">Lv. <%= level %></span>
            </li>
          <% end %>
        </ul>
      <% end %>
    </div>
  </div>
</section>


