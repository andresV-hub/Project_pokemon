<%# Elegir rival para el comparador (styles.md §6.9).
    JS hooks: #compare_pokemon_modal, #form-compare-pokemon, #compare-pokemon.
    El campo tenía el mismo id que el del modal de editar apodo, con los dos
    presentes en la misma página: HTML inválido y getElementById ambiguo. Aquí
    lleva id propio; ningún script lo consultaba. %>
<div class="modal dex-modal" id="compare_pokemon_modal" tabindex="-1" role="dialog"
     aria-hidden="true" aria-labelledby="compare-modal-title" data-bs-backdrop="false">
  <div class="modal-dialog modal-dialog-centered">
    <%# `turbo: false` porque `PokemonController#compare_with` responde con un
        `render` (200) en lugar de una redirección, y Turbo descarta en silencio
        las respuestas 200 a un envío de formulario: la petición salía, el
        servidor la atendía y la página se quedaba igual. Los otros tres modales
        no lo necesitan porque sus acciones redirigen con `status: :see_other`.
        Con esto el envío es una navegación normal del navegador. %>
    <%= form_with model: @pokemon,
                  url: compare_with_user_pokemon_path(user_id: current_user.id, id: @pokemon.id),
                  id: 'form-compare-pokemon',
                  data: { turbo: false } do |f| %>
      <div class="modal-content">
        <div class="modal-header">
          <h2 class="dex-modal__title" id="compare-modal-title">Compare with another species</h2>
        </div>

        <div class="modal-body">
          <div id="error-send-compare" class="dex-modal__error" role="alert"></div>

          <p class="dex-modal__text">
            Enter the Pokédex number of the species you want to compare with
            <%= @pokemon.display_name %>.
          </p>

          <div class="dex-field">
            <%= f.label :id, 'Pokédex number', for: 'compare-pokedex-number',
                        class: 'dex-field__label', id: 'label-compare' %>
            <%= f.number_field :id, id: 'compare-pokedex-number', min: 1,
                               value: nil, placeholder: 'For example, 25' %>
          </div>
        </div>

        <div class="modal-footer">
          <button type="button" class="dex-btn dex-btn--ghost" data-bs-dismiss="modal">Cancel</button>
          <%= button_tag 'Compare', type: 'button',
                         class: 'dex-btn dex-btn--primary', id: 'compare-pokemon' %>
        </div>
      </div>
    <% end %>
  </div>
</div>
