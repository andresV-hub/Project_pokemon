<%# Editar el apodo (styles.md §6.9). Es reversible, así que va con `dex-modal`
    normal y sin paso de confirmación.
    JS hooks: #edit_pokemon_modal, #form-edit-pokemon, #edit-pokemon. %>
<div class="modal dex-modal" id="edit_pokemon_modal" tabindex="-1" role="dialog"
     aria-hidden="true" aria-labelledby="edit-modal-title" data-bs-backdrop="false">
  <div class="modal-dialog modal-dialog-centered">
    <%= form_with model: @pokemon,
                  url: edit_nickname_user_pokemon_path(user_id: current_user.id, id: @pokemon.id),
                  method: :patch, id: 'form-edit-pokemon' do |f| %>
      <div class="modal-content">
        <div class="modal-header">
          <h2 class="dex-modal__title" id="edit-modal-title">Change nickname</h2>
        </div>

        <div class="modal-body">
          <p class="dex-modal__text">
            Choose what you want to name your <%= @pokemon.species_name %>.
          </p>

          <div class="dex-field">
            <%= f.label :nickname, 'Nickname', for: 'edit-nickname-pokemon-field',
                        class: 'dex-field__label', id: 'label-nickname-edit' %>
            <%= f.text_field :nickname, id: 'edit-nickname-pokemon-field',
                             value: @pokemon.nickname, placeholder: 'For example, Sparky' %>
          </div>
        </div>

        <div class="modal-footer">
          <button type="button" class="dex-btn dex-btn--ghost" data-bs-dismiss="modal">Cancel</button>
          <%= button_tag 'Save', type: 'button',
                         class: 'dex-btn dex-btn--primary', id: 'edit-pokemon' %>
        </div>
      </div>
    <% end %>
  </div>
</div>
