<%= render layout: 'application/page_header',
           locals: { eyebrow: 'Catalog', title: 'Pokédex',
                     lead: 'Search for a species and catch it to store it in your PC.' } do %>
  <%= link_to user_pokemon_index_path(user_id: current_user.id),
              class: 'dex-btn dex-btn--ghost' do %>
    <i class="fa fa-desktop" aria-hidden="true"></i>
    <span>Go to my PC</span>
  <% end %>
<% end %>

<% if @pokemons.any? %>
  <%= render 'application/pagination', collection: @pokemons %>

  <div class="dex-grid">
    <% @pokemons.each do |pokemon| %>
      <%= render 'species_card',
                 pokemon: pokemon,
                 captured: @captured_numbers.include?(pokemon.num_pokedex) %>
    <% end %>
  </div>

  <%= render 'application/pagination', collection: @pokemons %>
<% else %>
  <%# La Pokédex depende de un servicio externo: este estado se diseña
      (styles.md §6.14). %>
  <div class="dex-error" role="alert">
    <i class="fa fa-triangle-exclamation" aria-hidden="true"></i>
    <div class="dex-error__body">
      <h2 class="dex-error__title">Could not reach the PokeAPI</h2>
      <p>The catalog is fetched live from pokeapi.co. Please try again in a few seconds.</p>
      <%= link_to 'Retry', user_pokedex_index_path(user_id: current_user.id),
                  class: 'dex-btn dex-btn--ghost dex-btn--compact' %>
    </div>
  </div>
<% end %>
