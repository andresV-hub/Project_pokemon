{
  "name": "project_pokemon",
  "private": true,
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.7.2",
    "bootstrap": "5.3.8",
    "sass": "^1.83.0"
  },
  "scripts": {
    "build:css": "npm run build:fonts && sass ./app/assets/stylesheets/application.bootstrap.scss:./app/assets/builds/application.css --no-source-map --load-path=node_modules --quiet-deps",
    "build:fonts": "node -e \"require('fs').cpSync('node_modules/@fortawesome/fontawesome-free/webfonts','public/webfonts',{recursive:true})\"",
    "watch:css": "npm run build:css -- --watch"
  }
}
