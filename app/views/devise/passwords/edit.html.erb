<div class="dex-auth">
  <%= render 'application/auth_lockup', title: 'Choose a new password' %>

  <section class="dex-surface dex-surface--padded">
    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
      <%= render 'devise/shared/error_messages', resource: resource %>
      <%= f.hidden_field :reset_password_token %>

      <div class="dex-field">
        <%= f.label :password, 'New password', class: 'dex-field__label' %>
        <%= f.password_field :password, autofocus: true, autocomplete: 'new-password' %>
        <% if @minimum_password_length %>
          <p class="dex-field__hint">Minimum <%= @minimum_password_length %> characters.</p>
        <% end %>
      </div>

      <div class="dex-field">
        <%= f.label :password_confirmation, 'Confirm new password', class: 'dex-field__label' %>
        <%= f.password_field :password_confirmation, autocomplete: 'new-password' %>
      </div>

      <div class="dex-auth__actions">
        <%= f.submit 'Change password', class: 'dex-btn dex-btn--primary dex-btn--form dex-btn--block' %>
      </div>
    <% end %>
  </section>

  <%= render 'devise/shared/links' %>
</div>
