<%# Confirmación de liberar (styles.md §6.9). Es el ÚNICO modal destructivo de
    la aplicación: nombra al Pokémon por su apodo, porque es lo que el usuario
    va a perder.
    JS hooks: #delete_pokemon_modal, #form-destroy-pokemon, #delete-pokemon. %>
<div class="modal dex-modal dex-confirm" id="delete_pokemon_modal" tabindex="-1" role="dialog"
     aria-hidden="true" aria-labelledby="delete-modal-title" data-bs-backdrop="false">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <div>
          <span class="dex-confirm__icon" aria-hidden="true">
            <i class="fa fa-trash"></i>
          </span>
          <span class="dex-confirm__eyebrow">Irreversible action</span>
          <h2 class="dex-modal__title" id="delete-modal-title">
            Release <%= @pokemon.display_name %>
          </h2>
        </div>
      </div>

      <div class="modal-body">
        <p class="dex-modal__text">
          You are about to release <strong><%= @pokemon.display_name %></strong>, your
          <%= @pokemon.species_name %>. It will leave your PC and this action cannot be undone.
        </p>
      </div>

      <div class="modal-footer">
        <%= form_with model: @pokemon,
                      url: liberate_pokemon_user_pokemon_path(user_id: current_user.id, id: @pokemon.id),
                      method: :patch, id: 'form-destroy-pokemon' do |f| %>
          <button type="button" class="dex-btn dex-btn--ghost" data-bs-dismiss="modal">Cancel</button>
          <%= button_tag 'Release', type: 'button',
                         class: 'dex-btn dex-btn--danger-solid', id: 'delete-pokemon' %>
        <% end %>
      </div>
    </div>
  </div>
</div>
