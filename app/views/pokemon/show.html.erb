<%= render layout: 'application/page_header',
           locals: { eyebrow: 'My PC', title: @pokemon.display_name,
                     lead: @pokemon.species_name } do %>
  <%# Disparadores de los modales (styles.md §6.3). Son botones, no enlaces: no
      navegan a ninguna parte, abren un diálogo. Los IDs los consulta el script
      del final de esta vista. %>
  <button type="button" id="button-edit-nickname" class="dex-btn dex-btn--ghost">
    <i class="fa fa-pen" aria-hidden="true"></i>
    <span>Edit nickname</span>
  </button>
  <button type="button" id="button-to-modal-compare-pokemon" class="dex-btn dex-btn--ghost">
    <i class="fa fa-right-left" aria-hidden="true"></i>
    <span>Compare</span>
  </button>
  <button type="button" id="button-to-modal-delete-pokemon" class="dex-btn dex-btn--danger">
    <i class="fa fa-trash" aria-hidden="true"></i>
    <span>Release</span>
  </button>
<% end %>

<section class="dex-surface dex-surface--padded">
  <div class="dex-hero">
    <div>
      <%= render 'application/sprite', pokemon: @pokemon, variant: :pixel_lg, eager: true %>

      <p class="dex-hero__number">
        <%= @pokemon.dex_number %>
        <% if @pokemon.shiny? %>
          <span class="dex-badge">
            <i class="fa fa-star" aria-hidden="true"></i>
            Shiny
          </span>
        <% end %>
      </p>
      <%= render 'application/type_chips', pokemon: @pokemon %>

      <dl class="dex-hero__meta">
        <div>
          <dt>Level</dt>
          <dd><%= @pokemon.level %></dd>
        </div>
        <div class="dex-hero__meta-full">
          <dt>Experience</dt>
          <dd>
            <%= number_with_delimiter(@pokemon.experience) %> / <%= number_with_delimiter(@pokemon.next_level_experience) %>
            <%= render 'application/experience_bar', pokemon: @pokemon, variant: :detail %>
          </dd>
        </div>
        <% if @pokemon.ability.present? %>
          <div>
            <dt>Ability</dt>
            <dd>
              <%= ::Pokemons::Abilities.label(@pokemon.ability) %>
              <%# Se avisa si el combate todavía no sabe aplicarla: prometer una
                  habilidad que no hace nada es peor que no enseñarla, porque el
                  jugador contaría con ella. %>
              <% unless ::Pokemons::Abilities.supported?(@pokemon.ability) %>
                <span class="dex-badge dex-badge--muted">No effect yet</span>
              <% end %>
            </dd>
          </div>
        <% end %>
        <div>
          <dt>Species</dt>
          <dd><%= @pokemon.species_name %></dd>
        </div>
        <div>
          <dt>Habitat</dt>
          <dd><%= @pokemon.habitat.presence || 'Unknown' %></dd>
        </div>
        <div>
          <dt>Base happiness</dt>
          <dd><%= @pokemon.base_happiness || '—' %></dd>
        </div>
      </dl>
    </div>

    <div>
      <h2 class="dex-section-title">Description</h2>
      <p class="dex-hero__description"><%= @pokemon.description %></p>

      <h2 class="dex-section-title">Base stats</h2>
      <%= render 'application/stat_bars', pokemon: @pokemon %>

      <h2 class="dex-section-title">Type matchups</h2>
      <%= render 'application/matchups', matchups: @matchups %>

      <% if @pokemon.move_list.any? %>
        <h2 class="dex-section-title">Moves</h2>
        <ul class="dex-moves">
          <% @pokemon.move_list.each do |move| %>
            <li><%= move %></li>
          <% end %>
        </ul>
      <% end %>
    </div>
  </div>
</section>

<%= render 'modal_delete_pokemon' %>
<%= render 'modal_edit_nickname' %>
<%= render 'modal_to_compare_pokemon' %>

<script>
  document.addEventListener("turbo:load", function () {
    const modals = {
      delete:  document.getElementById("delete_pokemon_modal"),
      edit:    document.getElementById("edit_pokemon_modal"),
      compare: document.getElementById("compare_pokemon_modal")
    };

    function instance(el) {
      return el ? bootstrap.Modal.getOrCreateInstance(el) : null;
    }

    function openOnClick(buttonId, modalEl) {
      document.getElementById(buttonId)?.addEventListener("click", function (e) {
        e.preventDefault();
        instance(modalEl)?.show();
      });
    }

    function submitOnClick(buttonId, formId) {
      document.getElementById(buttonId)?.addEventListener("click", function () {
        document.getElementById(formId)?.requestSubmit();
      });
    }

    // Liberar
    openOnClick("button-to-modal-delete-pokemon", modals.delete);
    submitOnClick("delete-pokemon", "form-destroy-pokemon");

    // Editar mote
    openOnClick("button-edit-nickname", modals.edit);
    submitOnClick("edit-pokemon", "form-edit-pokemon");

    // Comparar
    openOnClick("button-to-modal-compare-pokemon", modals.compare);
    submitOnClick("compare-pokemon", "form-compare-pokemon");

    // Atajos de teclado
    document.addEventListener("keyup", function (e) {
      const open = Object.values(modals).find((el) => el?.classList.contains("show"));
      if (!open) return;

      if (e.key === "Enter") {
        open.querySelector("form")?.requestSubmit();
      } else if (e.key === "Escape") {
        instance(open)?.hide();
      }
    });
  });
</script>
