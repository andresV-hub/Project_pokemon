<%= render layout: 'application/page_header',
           locals: { eyebrow: 'Storage', title: 'My PC',
                     lead: 'The Pokémon you have caught, stored with the nicknames you gave them.' } do %>
  <%= link_to user_pokedex_index_path(user_id: current_user.id),
              class: 'dex-btn dex-btn--primary' do %>
    <i class="fa fa-book" aria-hidden="true"></i>
    <span>Explore the Pokédex</span>
  <% end %>
<% end %>

<% if @pokemons.any? %>
  <%= render 'application/pagination', collection: @pokemons %>

  <div class="dex-grid">
    <% @pokemons.each do |pokemon| %>
      <%= render 'stored_card', pokemon: pokemon %>
    <% end %>
  </div>

  <%= render 'application/pagination', collection: @pokemons %>
<% else %>
  <%= render layout: 'application/empty_state',
             locals: { title: 'Your PC is empty',
                       text: 'You have not caught any Pokémon yet. Open the Pokédex, choose a species, and give it a nickname.' } do %>
    <%= link_to 'Explore the Pokédex', user_pokedex_index_path(user_id: current_user.id),
                class: 'dex-btn dex-btn--primary' %>
  <% end %>
<% end %>
