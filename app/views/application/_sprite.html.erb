<%# Sprite sobre un tinte del tipo primario (styles.md §6.13).
    variant: :pixel (96px, listados) | :pixel_lg (192px) | :artwork (ficha)
    silhouette: true para las especies aún no vistas (§6.5). %>
<% variant = local_assigns.fetch(:variant, :pixel) %>
<% silhouette = local_assigns.fetch(:silhouette, false) %>
<% modifier = { pixel: 'dex-sprite--pixel', pixel_lg: 'dex-sprite--pixel-lg', artwork: 'dex-sprite--artwork' }.fetch(variant) %>
<% size = { pixel: 96, pixel_lg: 192, artwork: 320 }.fetch(variant) %>
<%# El texto alternativo tampoco puede revelar el nombre de una especie que el
    usuario no ha encontrado todavía. %>
<% alt = silhouette ? "Unseen species, Pokédex #{pokemon.dex_number}" : pokemon.sprite_alt %>
<%# El sprite se congela al capturar, así que un Pokémon guardado mientras la
    PokeAPI fallaba puede no tener ninguno. `image_tag(nil)` levanta «Nil location
    provided» y se lleva por delante la página entera: Mi PC, el equipo o el
    combate dejaban de pintarse por una imagen que falta. Se cae al sprite oficial,
    que se puede construir desde el número de Pokédex. %>
<% fuente = (variant == :artwork ? pokemon.artwork : pokemon.image).presence ||
            "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/#{pokemon.num_pokedex}.png" %>
<div class="dex-sprite <%= modifier %> <%= 'dex-sprite--silhouette' if silhouette %> dex-tinted--<%= silhouette ? 'unknown' : pokemon.type_slug %>">
  <%= image_tag(fuente,
                alt: alt,
                width: size,
                height: size,
                loading: local_assigns.fetch(:eager, false) ? 'eager' : 'lazy',
                fetchpriority: local_assigns.fetch(:eager, false) ? 'high' : 'auto') %>
</div>
