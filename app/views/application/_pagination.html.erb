<%# Controles de paginación reutilizables por cualquier vista que reciba una
    colección de Kaminari (Active Record o array paginado de la PokeAPI).
    Estilo en styles.md §6.12. %>
<% if collection.total_pages > 1 %>
  <nav class="dex-pager" aria-label="Pagination">
    <%= paginate collection %>
    <p class="dex-pager__summary">
      Page <%= collection.current_page %> of <%= collection.total_pages %> ·
      <%= collection.total_count %> Pokémon
    </p>
  </nav>
<% end %>
