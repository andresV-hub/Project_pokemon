<%# Tarjeta de Pokémon capturado (styles.md §6.6). El apodo manda; debajo, la
    especie. La franja izquierda lleva el color del tipo primario. %>
<article class="dex-card dex-card--stored dex-tinted--<%= pokemon.type_slug %>">
  <%= link_to user_pokemon_path(user_id: current_user.id, id: pokemon.id),
              class: 'dex-card__link',
              'aria-label': "View #{pokemon.display_name} details" do %><% end %>

  <div class="dex-card__top">
    <span class="dex-card__number"><%= pokemon.dex_number %></span>
    <% if pokemon.shiny? %>
      <span class="dex-badge">
        <i class="fa fa-star" aria-hidden="true"></i>
        Shiny
      </span>
    <% end %>
  </div>

  <div class="dex-card__body">
    <%= render 'application/sprite', pokemon: pokemon, variant: :pixel %>
    <h2 class="dex-card__title"><%= pokemon.display_name %></h2>
    <p class="dex-card__species"><%= pokemon.species_name %></p>
    <%= render 'application/type_chips', pokemon: pokemon %>
  </div>

  <div class="dex-card__actions">
    <%= link_to 'View details', user_pokemon_path(user_id: current_user.id, id: pokemon.id),
                class: 'dex-btn dex-btn--ghost dex-btn--compact' %>
    <%= button_to 'Add to party',
                  add_to_party_user_pokemon_path(user_id: current_user.id, id: pokemon.id),
                  method: :patch,
                  class: 'dex-btn dex-btn--accent dex-btn--compact',
                  form_class: 'dex-card__form' %>
  </div>
</article>
