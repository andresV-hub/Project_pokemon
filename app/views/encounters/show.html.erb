<% over = @state['over'].present? %>
<% trainer_battle = @state['kind'] == 'trainer' %>
<%= render layout: 'application/page_header',
           locals: { eyebrow: trainer_battle ? "#{@state['rival']} · reward ₽#{@state['reward']}" : 'Wild encounter',
                     title: trainer_battle ? @state['name'] : "Wild #{@state['name']}" } do %>
<% end %>

<% if trainer_battle %>
  <p class="dex-encounter__team">
    <%= @state['rival'] %>'s team:
    <% Array(@state['team']).each_with_index do |member, index| %>
      <span class="dex-encounter__member <%= 'dex-encounter__member--down' if index < @state['index'].to_i %>
                   <%= 'dex-encounter__member--current' if index == @state['index'].to_i %>">
        <%= member['name'] %>
      </span>
    <% end %>
  </p>
<% end %>

<section class="dex-surface dex-surface--padded dex-encounter">
  <div class="dex-encounter__side">
    <%# El salvaje: barra de HP arriba, como en el juego. %>
    <div class="dex-hp">
      <div class="dex-hp__head">
        <span class="dex-hp__name">
          <%= @state['name'] %>
          <span class="dex-hp__level">Lv. <%= @state['level'] %></span>
        </span>
        <span class="dex-hp__value"><%= @state['wild_hp'] %> / <%= @state['wild_max_hp'] %></span>
      </div>
      <div class="dex-hp__track" role="meter"
           aria-label="<%= @state['name'] %> HP"
           aria-valuenow="<%= @state['wild_hp'] %>" aria-valuemin="0"
           aria-valuemax="<%= @state['wild_max_hp'] %>">
        <% ratio = @state['wild_max_hp'].to_i.positive? ? @state['wild_hp'] * 100.0 / @state['wild_max_hp'] : 0 %>
        <span class="dex-hp__fill <%= 'dex-hp__fill--low' if ratio <= 25 %> <%= 'dex-hp__fill--mid' if ratio > 25 && ratio <= 50 %>"
              style="width: <%= ratio.round %>%"></span>
      </div>
    </div>

    <% if @wild %>
      <%= render 'application/sprite', pokemon: @wild, variant: :pixel_lg, eager: true %>
      <%= render 'application/type_chips', pokemon: @wild %>
    <% end %>
  </div>

  <div class="dex-encounter__side">
    <div class="dex-hp">
      <div class="dex-hp__head">
        <span class="dex-hp__name">
          <%= @trainer_pokemon.display_name %>
          <span class="dex-hp__level">Lv. <%= @state['trainer_level'] || @trainer_pokemon.level %></span>
        </span>
        <span class="dex-hp__value"><%= @state['trainer_hp'] %> / <%= @state['trainer_max_hp'] %></span>
      </div>
      <div class="dex-hp__track" role="meter"
           aria-label="<%= @trainer_pokemon.display_name %> HP"
           aria-valuenow="<%= @state['trainer_hp'] %>" aria-valuemin="0"
           aria-valuemax="<%= @state['trainer_max_hp'] %>">
        <% mine = @state['trainer_max_hp'].to_i.positive? ? @state['trainer_hp'] * 100.0 / @state['trainer_max_hp'] : 0 %>
        <span class="dex-hp__fill <%= 'dex-hp__fill--low' if mine <= 25 %> <%= 'dex-hp__fill--mid' if mine > 25 && mine <= 50 %>"
              style="width: <%= mine.round %>%"></span>
      </div>
    </div>

    <%= render 'application/sprite', pokemon: @trainer_pokemon, variant: :pixel, eager: true %>
    <%= render 'application/type_chips', pokemon: @trainer_pokemon %>
  </div>
</section>

<%# El registro de lo ocurrido, en la caja de diálogo de la captura (§6.20). %>
<div class="dex-dialog dex-dialog--log">
  <% Array(@state['log']).each do |line| %>
    <span><%= line %></span>
  <% end %>
</div>

<div class="dex-encounter__actions">
  <% if over %>
    <%= button_to 'Back to Explore', user_encounter_flee_path(user_id: current_user.id),
                  class: 'dex-btn dex-btn--primary', form_class: 'dex-encounter__form' %>
  <% else %>
    <%# Un botón por movimiento, con su tipo y los PP que quedan: elegir cuál
        usar es la decisión del turno (styles.md §6.27). %>
    <div class="dex-moves-bar">
      <% Array(@state['own_moves']).each_with_index do |move, index| %>
        <%= button_to user_encounter_attack_path(user_id: current_user.id, move: index),
                      class: "dex-move dex-tinted--#{move['type']}",
                      form_class: 'dex-encounter__form',
                      disabled: move['pp_left'].to_i.zero? do %>
          <span class="dex-move__name"><%= move['label'] %></span>
          <span class="dex-move__meta">
            <span class="dex-type dex-type--<%= move['type'] %>"><%= move['type'] %></span>
            <span class="dex-move__pp"><%= move['pp_left'] %>/<%= move['pp'] %></span>
          </span>
        <% end %>
      <% end %>
    </div>
    <%# Una acción por tipo de bola que se tenga: elegir cuál gastar es la
        decisión que la tienda hace interesante. %>
    <% unless trainer_battle %>
      <% current_user.inventory_items.available.each do |item| %>
        <%= button_to "#{item.name} (#{item.quantity})",
                      user_encounter_catch_path(user_id: current_user.id, kind: item.kind),
                      class: 'dex-btn dex-btn--accent', form_class: 'dex-encounter__form' %>
      <% end %>
      <% if current_user.inventory_items.available.none? %>
        <span class="dex-field__hint">No balls left — visit the shop.</span>
      <% end %>
    <% end %>
    <%= button_to 'Run', user_encounter_flee_path(user_id: current_user.id),
                  class: 'dex-btn dex-btn--ghost', form_class: 'dex-encounter__form' %>
  <% end %>
</div>
