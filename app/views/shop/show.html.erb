<%= render layout: 'application/page_header',
           locals: { eyebrow: 'Shop', title: 'Poké Mart',
                     lead: 'Beat trainers to earn money. Spend it on better balls and on potions for the fights you were not expecting.' } do %>
  <%= link_to user_explore_path(user_id: current_user.id), class: 'dex-btn dex-btn--ghost' do %>
    <i class="fa fa-compass" aria-hidden="true"></i>
    <span>Explore</span>
  <% end %>
<% end %>

<%# Las bolas y los remedios se separan porque resuelven cosas distintas: unas
    sirven para quedarte con un Pokémon y los otros para no perder el combate. En
    una sola rejilla parecían seis variantes de lo mismo. %>
<% [['Poké Balls', :ball], ['Medicine', nil]].each do |titulo, categoria| %>
  <% grupo = @items.select { |kind, _| categoria ? ::Shop::Catalog.ball?(kind) : !::Shop::Catalog.ball?(kind) } %>
  <% next if grupo.empty? %>

  <h2 class="dex-section-title"><%= titulo %></h2>
  <div class="dex-grid dex-grid--party">
    <% grupo.each do |kind, item| %>
      <% owned = @owned[kind]&.quantity.to_i %>
      <% affordable = current_user.money >= item[:price] %>
      <article class="dex-card dex-shop__item">
        <div class="dex-card__top">
          <span class="dex-card__title"><%= item[:name] %></span>
          <span class="dex-badge">x<%= owned %></span>
        </div>

        <div class="dex-card__body">
          <%# El sprite viene del mismo repositorio que los de los Pokémon. Es
              decorativo —el nombre está justo encima—, así que va con `alt`
              vacío para que un lector de pantalla no lo lea dos veces. %>
          <img class="dex-shop__sprite" src="<%= ::Shop::Catalog.sprite(kind) %>"
               alt="" loading="lazy" width="48" height="48">
          <p class="dex-card__species"><%= item[:description] %></p>
          <% if ::Shop::Catalog.ball?(kind) %>
            <p class="dex-shop__effect">Catch rate ×<%= item[:multiplier] %></p>
          <% end %>
        </div>

        <div class="dex-card__actions">
          <%= button_to "Buy · ₽#{number_with_delimiter(item[:price])}",
                        user_shop_buy_path(user_id: current_user.id, kind: kind),
                        class: "dex-btn dex-btn--compact dex-btn--block #{affordable ? 'dex-btn--accent' : 'dex-btn--ghost'}",
                        form_class: 'dex-card__form',
                        disabled: !affordable %>
        </div>
      </article>
    <% end %>
  </div>
<% end %>
