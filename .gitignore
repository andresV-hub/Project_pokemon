# Ignora los ficheros generados por la aplicación.

# Dependencias
/node_modules
/.bundle

# Assets compilados por `npm run build:css` y fuentes copiadas de Font Awesome
/app/assets/builds/*
!/app/assets/builds/.keep
/public/assets
/public/webfonts

# Ficheros temporales y logs
/log/*
!/log/.keep
/tmp/*
!/tmp/.keep
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep
/storage/*
!/storage/.keep

# Herramientas locales del editor y del asistente
/.claude
/.idea
# oh-my-claudecode deja estado de sesión en cualquier nivel del árbol,
# no sólo en la raíz.
.omc/

# Nunca subir la clave maestra de las credenciales
/config/master.key

# Documentación de trabajo local (no se versiona)
/docs

# Base de datos SQLite del entorno de test. El nombre lo decide la variable
# SETTINGS__DATABASE__DB_NAME del contenedor, que pisa el `project_pokemon` de
# config/settings/test.yml: por eso el fichero se llama `project_pokemon_dev`
# aunque sea la base de test y no la de desarrollo.
/project_pokemon_dev
*.sqlite3
*.sqlite3-journal

# Skills de agentes instaladas con `npx skills add`. Se versiona el lock, que
# permite reinstalarlas, y no los ficheros: son dependencias descargadas, como
# node_modules.
.agents/
