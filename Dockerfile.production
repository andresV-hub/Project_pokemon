# syntax=docker/dockerfile:1
# Imagen de producción, la que despliega Fly.io.
#
# Va aparte del `Dockerfile` de desarrollo a propósito: aquel monta el código como
# volumen, corre en modo desarrollo y trae las herramientas de compilar. Aquí el
# código va dentro de la imagen, los assets se construyen al montarla y no queda
# ni compilador ni Node en la imagen final.
ARG RUBY_VERSION=3.4.9
FROM docker.io/library/ruby:$RUBY_VERSION-slim AS base

WORKDIR /rails

ENV RAILS_ENV=production \
    BUNDLE_DEPLOYMENT=1 \
    BUNDLE_PATH=/usr/local/bundle \
    BUNDLE_WITHOUT=development:test

# --- Construcción --------------------------------------------------------------
FROM base AS build

# `libpq-dev` para compilar la gema `pg`, y Node para el CSS de Bootstrap con Dart
# Sass. Nada de esto viaja a la imagen final.
RUN apt-get update -qq \
 && apt-get install --no-install-recommends -y \
      build-essential curl git libpq-dev libyaml-dev pkg-config \
 && curl -fsSL https://deb.nodesource.com/setup_24.x | bash - \
 && apt-get install --no-install-recommends -y nodejs \
 && rm -rf /var/lib/apt/lists/*

COPY Gemfile Gemfile.lock ./
RUN bundle install \
 && rm -rf "$BUNDLE_PATH"/ruby/*/cache "$BUNDLE_PATH"/ruby/*/bundler/gems/*/.git

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

# El bit de ejecución de `bin/` no sobrevive a un repositorio clonado en Windows, y
# sin él la imagen se construye bien pero no arranca: el ENTRYPOINT no se puede
# lanzar y el despliegue muere con un código que no dice nada. El `Dockerfile` de
# desarrollo ya lo hacía; aquí faltaba.
RUN chmod +x bin/*

# Los assets se precompilan al montar la imagen, no al arrancar: arrancar es lo que
# hace esperar al primer visitante cuando la máquina estaba dormida.
#
# `SECRET_KEY_BASE_DUMMY` deja precompilar sin la clave real, que no está aquí y no
# debe estarlo: viaja como variable de entorno del servidor.
RUN npm run build:css \
 && SECRET_KEY_BASE_DUMMY=1 ./bin/rails assets:precompile \
 && rm -rf node_modules tmp/cache

# --- Imagen final --------------------------------------------------------------
FROM base

# Sólo la biblioteca cliente de PostgreSQL, no las cabeceras de compilar.
RUN apt-get update -qq \
 && apt-get install --no-install-recommends -y curl libjemalloc2 libpq5 postgresql-client tzdata \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/*

ENV LD_PRELOAD=libjemalloc.so.2

COPY --from=build "$BUNDLE_PATH" "$BUNDLE_PATH"
COPY --from=build /rails /rails

# Sin root: si alguien se cuela por un fallo de la aplicación, se encuentra una
# cuenta sin permisos en vez del administrador de la máquina.
RUN groupadd --system --gid 1000 rails \
 && useradd rails --uid 1000 --gid 1000 --create-home --shell /bin/bash \
 && chown -R rails:rails db log storage tmp
USER 1000:1000

EXPOSE 3000
ENTRYPOINT ["/rails/bin/docker-entrypoint"]
CMD ["./bin/rails", "server", "-b", "0.0.0.0"]
