<%= render layout: 'application/page_header',
           locals: { eyebrow: 'Pokédex', title: @pokemon.name } do %>
  <%= link_to 'Back to catalog', user_pokedex_index_path(user_id: current_user.id),
              class: 'dex-btn dex-btn--ghost' %>
  <%# Abre el modal de captura: el script de esta vista engancha por ID. %>
  <%= link_to 'Catch',
              user_pokedex_path(user_id: current_user.id, id: @pokemon.id),
              id: 'try-catch-pokemon',
              class: 'dex-btn dex-btn--accent' %>
<% end %>

<section class="dex-surface dex-surface--padded">
  <div class="dex-hero">
    <div>
      <%# Artwork oficial en la ficha; el sprite pequeño se reserva a los
          listados (styles.md §6.13). %>
      <%= render 'application/sprite', pokemon: @pokemon, variant: :artwork, eager: true %>

      <p class="dex-hero__number"><%= @pokemon.dex_number %></p>
      <%= render 'application/type_chips', pokemon: @pokemon %>

      <dl class="dex-hero__meta">
        <div>
          <dt>Habitat</dt>
          <dd><%= @description&.habitat || 'Unknown' %></dd>
        </div>
        <div>
          <dt>Catch rate</dt>
          <dd><%= @description&.capture_rate ? "#{@description.capture_rate}%" : '—' %></dd>
        </div>
        <div>
          <dt>Base happiness</dt>
          <dd><%= @description&.base_happiness || '—' %></dd>
        </div>
      </dl>
    </div>

    <div>
      <h2 class="dex-section-title">Description</h2>
      <% if @description&.description.present? %>
        <p class="dex-hero__description"><%= @description.description %></p>
      <% else %>
        <p class="dex-hero__description"><%= t('.no_description', default: 'The PokeAPI does not have a Pokédex entry for this species.') %></p>
      <% end %>

      <h2 class="dex-section-title">Base stats</h2>
      <%= render 'application/stat_bars', pokemon: @pokemon %>

      <% if @pokemon.move_list.any? %>
        <h2 class="dex-section-title">Moves</h2>
        <ul class="dex-moves">
          <% @pokemon.move_list.each do |move| %>
            <li><%= move %></li>
          <% end %>
        </ul>
      <% end %>
    </div>
  </div>
</section>

<%= render 'modal_form_catch_pokemon' %>

<script>
  // Turbo vuelve a ejecutar este bloque en cada visita, por eso se engancha
  // a turbo:load en lugar de a DOMContentLoaded.
  document.addEventListener("turbo:load", function () {
    const openButton  = document.getElementById("try-catch-pokemon");
    const catchButton = document.getElementById("catch-pokemon");
    const modalEl     = document.getElementById("block_user_modal");
    const form        = document.getElementById("form-catch-pokemon");
    const nickname    = document.getElementById("nickname-pokemon-field");
    const errorBox    = document.getElementById("error-send");

    if (!modalEl || !form) return;

    const modal = bootstrap.Modal.getOrCreateInstance(modalEl);

    function submitIfNamed() {
      if (nickname.value.trim() === "") {
        errorBox.textContent = "Choose a nickname for <%= j @pokemon.name %>";
      } else {
        form.requestSubmit();
      }
    }

    openButton?.addEventListener("click", function (e) {
      e.preventDefault();
      modal.show();
    });

    catchButton?.addEventListener("click", submitIfNamed);

    document.addEventListener("keyup", function (e) {
      if (e.key === "Enter" && modalEl.classList.contains("show")) submitIfNamed();
      if (e.key === "Escape") modal.hide();
    });
  });
</script>
