<%# Tarjeta de especie (styles.md §6.5). Toda la tarjeta enlaza a la ficha; el
    botón de capturar es un control anidado sobre esa capa. %>
<article class="dex-card">
  <%= link_to user_pokedex_path(user_id: current_user.id, id: pokemon.id),
              class: 'dex-card__link',
              'aria-label': "View #{pokemon.name} details" do %><% end %>

  <div class="dex-card__top">
    <span class="dex-card__number"><%= pokemon.dex_number %></span>
    <% if local_assigns[:captured] %>
      <span class="dex-badge">In your PC</span>
    <% end %>
  </div>

  <div class="dex-card__body">
    <%= render 'application/sprite', pokemon: pokemon, variant: :pixel %>
    <h2 class="dex-card__title"><%= pokemon.name %></h2>
    <%= render 'application/type_chips', pokemon: pokemon %>
  </div>

  <div class="dex-card__actions">
    <%= link_to 'View details',
                user_pokedex_path(user_id: current_user.id, id: pokemon.id),
                class: 'dex-btn dex-btn--ghost dex-btn--compact dex-btn--block' %>
  </div>
</article>
