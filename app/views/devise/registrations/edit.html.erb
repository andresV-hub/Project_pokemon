<div class="dex-auth">
  <%= render 'application/auth_lockup', title: 'Your account' %>

  <section class="dex-surface dex-surface--padded">
    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
      <%= render 'devise/shared/error_messages', resource: resource %>

      <div class="dex-field">
        <%= f.label :email, 'Email address', class: 'dex-field__label' %>
        <%= f.email_field :email, autofocus: true, autocomplete: 'email' %>
      </div>

      <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
        <p class="dex-field__hint">Pending confirmation: <%= resource.unconfirmed_email %></p>
      <% end %>

      <div class="dex-field">
        <%= f.label :password, 'New password', class: 'dex-field__label' %>
        <%= f.password_field :password, autocomplete: 'new-password' %>
        <p class="dex-field__hint">
          Leave blank if you do not want to change it<%= ". Minimum #{@minimum_password_length} characters" if @minimum_password_length %>.
        </p>
      </div>

      <div class="dex-field">
        <%= f.label :password_confirmation, 'Confirm new password', class: 'dex-field__label' %>
        <%= f.password_field :password_confirmation, autocomplete: 'new-password' %>
      </div>

      <div class="dex-field">
        <%= f.label :current_password, 'Current password', class: 'dex-field__label' %>
        <%= f.password_field :current_password, autocomplete: 'current-password' %>
        <p class="dex-field__hint">We need your current password to confirm your changes.</p>
      </div>

      <div class="dex-auth__actions">
        <%= f.submit 'Save changes', class: 'dex-btn dex-btn--primary dex-btn--form dex-btn--block' %>
      </div>
    <% end %>
  </section>

  <section class="dex-surface dex-surface--padded mt-4">
    <h2 class="dex-section-title">Delete account</h2>
    <p class="dex-field__hint">
      Your account and all Pokémon in your PC will be deleted. This action cannot be undone.
    </p>
    <%= button_to 'Delete my account', registration_path(resource_name),
                  method: :delete,
                  class: 'dex-btn dex-btn--danger',
                  form: { data: { turbo_confirm: 'Are you sure you want to delete your account?' } } %>
  </section>
</div>
