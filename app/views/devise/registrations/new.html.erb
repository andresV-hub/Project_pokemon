<div class="dex-auth">
  <%= render 'application/auth_lockup',
             title: 'Create your account',
             lead: 'You need an account to catch Pokémon and store them in your PC.' %>

  <section class="dex-surface dex-surface--padded">
    <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
      <%= render 'devise/shared/error_messages', resource: resource %>

      <div class="dex-auth__grid">
        <div class="dex-field">
          <%= f.label :name, 'First name', class: 'dex-field__label' %>
          <%= f.text_field :name, autocomplete: 'given-name', placeholder: 'Your first name' %>
        </div>

        <div class="dex-field">
          <%= f.label :last_name, 'Last name', class: 'dex-field__label' %>
          <%= f.text_field :last_name, autocomplete: 'family-name', placeholder: 'Your last name' %>
        </div>

        <div class="dex-field">
          <%= f.label :email, 'Email address', class: 'dex-field__label' %>
          <%= f.email_field :email, autofocus: true, autocomplete: 'email', placeholder: 'you@example.com' %>
        </div>

        <div class="dex-field">
          <%= f.label :phone, 'Phone number', class: 'dex-field__label' %>
          <%= f.text_field :phone, autocomplete: 'tel', placeholder: 'Optional' %>
        </div>

        <div class="dex-field">
          <%= f.label :password, 'Password', class: 'dex-field__label' %>
          <%= f.password_field :password, autocomplete: 'new-password' %>
          <% if @minimum_password_length %>
            <p class="dex-field__hint">Minimum <%= @minimum_password_length %> characters.</p>
          <% end %>
        </div>

        <div class="dex-field">
          <%= f.label :password_confirmation, 'Confirm password', class: 'dex-field__label' %>
          <%= f.password_field :password_confirmation, autocomplete: 'new-password' %>
        </div>
      </div>

      <%# Elegir el inicial es el momento más reconocible del juego, y además
          resuelve un problema real: sin ningún Pokémon no hay con quién combatir
          y los encuentros serían un callejón sin salida. %>
      <fieldset class="dex-starter">
        <legend class="dex-field__label">Choose your first partner</legend>
        <div class="dex-starter__options">
          <% User::STARTERS.each_with_index do |(num, starter), index| %>
            <label class="dex-starter__option dex-tinted--<%= starter[:type] %>">
              <%= f.radio_button :starter_num_pokedex, num, checked: index.zero?,
                                 class: 'dex-starter__radio' %>
              <%= image_tag "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/#{num}.png",
                            alt: '', width: 72, height: 72, loading: 'lazy',
                            class: 'dex-starter__sprite' %>
              <span class="dex-starter__name"><%= starter[:name] %></span>
            </label>
          <% end %>
        </div>
      </fieldset>

      <div class="dex-auth__actions">
        <%= f.submit 'Create account', class: 'dex-btn dex-btn--primary dex-btn--form dex-btn--block' %>
      </div>
    <% end %>
  </section>

  <%= render 'devise/shared/links' %>
</div>
